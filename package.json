{
  "name": "freelance-pay-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client",
    "install-all": "npm install && npm install --prefix server && npm install --prefix client",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "clean": "rimraf node_modules client/node_modules server/node_modules",
    "build": "npm run build --prefix client",
    "deploy:api": "npm run deploy --prefix server",
    "deploy:client": "npm run build --prefix client && npx wrangler pages deploy client/dist --project-name freelance-pay-cloud",
    "deploy": "npm run deploy:api && npm run deploy:client",
    "test": "echo \"Error: no test specified\" && exit 1"

  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
